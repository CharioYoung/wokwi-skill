# Normalize line endings so the repo behaves the same on every platform.
* text=auto eol=lf

# Shell scripts MUST stay LF or they break on Linux/macOS and inside Docker.
*.sh   text eol=lf
*.bash text eol=lf

# PowerShell on Windows prefers CRLF; it also tolerates LF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binary assets.
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.bin  binary
